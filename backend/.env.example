# Groq API Key for GenAI Data Analyst Agent
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Required Langfuse tracing. Backend startup fails if credentials are missing or tracing is disabled.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Required to issue/verify JWTs. Generate a unique random value for each deployment.
AUTH_SECRET_KEY=

# Optional account map for POST /auth/token, formatted as JSON.
# Example shape: {"analyst":{"password":"replace-with-a-private-password","role":"analyst"}}
# Do not commit real credentials. With this unset, token issuance fails closed.
AUTH_USERS_JSON=

# Shared unauthenticated demo identity; disable for deployments handling private datasets.
ALLOW_DEMO_ANONYMOUS=true
